pipeline {
    agent any
    parameters { string(name: 'BRANCH_NAME', defaultValue: 'master, description: 'Enter the branch name to build') }

    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Hi'){
            steps{
                echo 'Hi'
            }
        }
        stage('Git checkout'){
            steps{
                git branch: '$BRANCH_NAME', git changelog: false, credentialsId: 'ci-file-credential', poll: false, url: 'https://github.com/Dadah3227/python-coding.git'
                sh 'ls -ltr' // Linux
             // bat 'dir' //windows
            }
        }
    }
}